{
  "name": "@game25011/dsh-remote-access",
  "version": "0.3.0",
  "description": "Remote-control the local DSH through Tailscale: expose the running DSH Web UI to your tailnet. The settings page checks every prerequisite, then shows the login link and QR; /remote does the same from the command line.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "assets",
    "lib/vendor/qrcode.mjs",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "docs/INTERFACE.md",
    "docs/RELEASING.md",
    "docs/TEST-REPORT.md",
    "README.md",
    "CHANGELOG.md",
    "AI-DISCLOSURE.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.0 <0.3.0",
    "node": ">=20"
  },
  "author": "game25011",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/game25011/dsh-remote-access.git"
  },
  "homepage": "https://github.com/game25011/dsh-remote-access#readme",
  "bugs": {
    "url": "https://github.com/game25011/dsh-remote-access/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "tailscale", "remote", "webui", "tailnet", "qr"],
  "scripts": {
    "test": "node --test test/core.test.js test/command.test.js test/client.test.js",
    "pack": "npm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}